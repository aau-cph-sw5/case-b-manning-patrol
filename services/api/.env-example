# This is an example of a .env file for local development.
# You must create your own 'services/api/.env' file locally.
# The real '.env' file is intentionally ignored by Git (see .gitignore).
# It may contain private or sensitive information and must never be committed to Git.

# The local Docker Compose setup uses fixed database credentials: metro / admin.
# The credentials are only for your local Postgres container.
# To avoid merge conflicts, do not change these values in docker-compose.yml.

# This is the only line required in your local '.env' file:
DATABASE_URL=postgresql+asyncpg://metro:admin@db:5432/postgres-db

# See the README for full Docker Compose setup instructions.
{
  "version": "2026-11-10.1",
  "source": "Metro role decision of 7 November 2026 (source story B6.2), with team interpretations proposed in ADR 0013",
  "default": "deny",
  "audit": { "log_every_individual_presence_access": true },
  "permissions": {
    "steward_own_patrol_record_view": {
      "description": "Allows stewards to view their patrol interface."
    },
    "connection_event_send": {
      "description": "Allows sending connection events."
    },
    "disconnection_event_send": {
      "description": "Allows sending disconnection events."
    },
    "patrol_session_start": {
      "description": "Allows sending a patrol session start event."
    },
    "patrol_session_stop": {
      "description": "Allows sending a patrol session stop event."
    },
    "station_manning_coverage_view": {
      "description": "Allows viewing the shared station coverage dashboard stream."
    },
    "train_manning_coverage_view": {
      "description": "Allows viewing the train manning stream."
    },
    "adjustment_event_send": {
      "description": "Allows sending corrections to recorded steward events."
    },
    "at_risk_count_view": {
      "description": "Allows viewing the at-risk episode count."
    },
    "patrol_record_view_all": {
      "description": "Allows viewing any steward's patrol records, not just the caller's own."
    },
    "at_risk_threshold_view": {
      "description": "Allows reading the at-risk threshold setting."
    },
    "at_risk_threshold_set": {
      "description": "Allows changing the at-risk threshold setting."
    },
    "historical_data": {
      "description": "Allows retrieving historical data for all station and train coverage"
    }
  },
  "roles": [
    {
      "role": "steward",
      "label": "Steward",
      "grants": [
        { "data": "presence", "subject": "own", "lines": "all", "shift_scope": "current" },
        { "data": "coverage", "subject": "all", "lines": "own", "shift_scope": "current" }
      ],
      "permissions": [
        "connection_event_send", "disconnection_event_send", "steward_own_patrol_record_view", 
        "patrol_session_start", "patrol_session_stop", "station_manning_coverage_view"
      ]
    },
    {
      "role": "stewardSupervisor",
      "label": "Steward Supervisor",
      "grants": [
        { "data": "presence", "subject": "all", "lines": "own", "shift_scope": "current" },
        { "data": "coverage", "subject": "all", "lines": "own", "shift_scope": "current" }
      ],
      "permissions": [
        "connection_event_send", "disconnection_event_send", "steward_own_patrol_record_view",
        "patrol_session_start", "patrol_session_stop", "station_manning_coverage_view", "patrol_record_view_all"
      ]
    },
    {
      "role": "controlRoomOperator",
      "label": "Control Room Operator",
      "grants": [
        { "data": "presence", "subject": "all", "lines": "all", "shift_scope": "current" },
        { "data": "coverage", "subject": "all", "lines": "all", "shift_scope": "current" }
      ],
      "permissions":["connection_event_send", "disconnection_event_send", "steward_own_patrol_record_view",
        "patrol_session_start", "patrol_session_stop", "station_manning_coverage_view", "train_manning_coverage_view", "adjustment_event_send", "at_risk_count_view", "patrol_record_view_all",
        "at_risk_threshold_view", "at_risk_threshold_set"]
    },
    {
      "role": "operations_administrator",
      "label": "Operations Administrator",
      "grants": [
        { "data": "presence", "subject": "all", "lines": "all", "shift_scope": "all" },
        { "data": "coverage", "subject": "all", "lines": "all", "shift_scope": "current" }
      ],
      "permissions":["connection_event_send", "disconnection_event_send", "steward_own_patrol_record_view",
        "patrol_session_start", "patrol_session_stop", "station_manning_coverage_view", "train_manning_coverage_view", "adjustment_event_send", "at_risk_count_view", "patrol_record_view_all",
        "at_risk_threshold_view", "at_risk_threshold_set", "historical_data"]
    },
    {
      "role": "it_administrator",
      "label": "IT Administrator",
      "grants": [
        { "data": "reference", "subject": "all", "lines": "all", "shift_scope": "all" }
      ]
    }
  ]
}

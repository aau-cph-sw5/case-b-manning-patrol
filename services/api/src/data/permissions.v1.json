{
  "version": "2026-11-10.1",
  "source": "Metro role decision of 7 November 2026 (source story B6.2), with team interpretations proposed in ADR 0013",
  "default": "deny",
  "audit": { "log_every_individual_presence_access": true },
  "permissions": {
    "steward_patrol_view": {
      "description": "Allows stewards to view their patrol interface."
    },
    "connection_event_send": {
      "description": "Allows sending connection events."
    }
  },
  "roles": [
    {
      "role": "steward",
      "label": "Steward",
      "grants": [
        { "data": "presence", "subject": "own", "lines": "all", "shift_scope": "current" },
        { "data": "coverage", "subject": "all", "lines": "own", "shift_scope": "current" }
      ],
      "permissions": [
        "connection_event_send", "steward_patrol_view"
      ]
    },
    {
      "role": "stewardSupervisor",
      "label": "Steward Supervisor",
      "grants": [
        { "data": "presence", "subject": "all", "lines": "own", "shift_scope": "current" },
        { "data": "coverage", "subject": "all", "lines": "own", "shift_scope": "current" }
      ]
    },
    {
      "role": "controlRoomOperator",
      "label": "Control Room Operator",
      "grants": [
        { "data": "presence", "subject": "all", "lines": "all", "shift_scope": "current" },
        { "data": "coverage", "subject": "all", "lines": "all", "shift_scope": "current" }
      ]
    },
    {
      "role": "operations_administrator",
      "label": "Operations Administrator",
      "grants": [
        { "data": "presence", "subject": "all", "lines": "all", "shift_scope": "all" },
        { "data": "coverage", "subject": "all", "lines": "all", "shift_scope": "current" }
      ]
    },
    {
      "role": "it_administrator",
      "label": "IT Administrator",
      "grants": [
        { "data": "reference", "subject": "all", "lines": "all", "shift_scope": "all" }
      ]
    }
  ]
}

EXPO_PUBLIC_API_URL=http://localhost:8000

# Role claim sent as the bearer token until real sign-in exists.
# The steward app only acts as: steward
EXPO_PUBLIC_ROLE=steward

# Beacon simulation mode: random (default) or fixture.
EXPO_PUBLIC_BEACON_MODE=fixture
# The fixture's original time gaps are divided by this value.
# Ten times faster than the approximately 47-minute M1 route demo.
EXPO_PUBLIC_FIXTURE_REPLAY_SPEED=10

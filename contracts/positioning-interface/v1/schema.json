{
	"openapi": "3.0.0",
	"info": {
		"title": "Positioning Interface API",
		"description": "Backend API contract for station presence positioning data. Consumed by frontend, dashboard, and reporting services.",
		"version": "1.0.0"
	},
	"servers": [
		{
			"url": "http://localhost:8000",
			"description": "Local development"
		}
	],
	"paths": {
		"/observations": {
			"get": {
				"summary": "Get current observations",
				"description": "Returns the set of areas currently observed by the device. Each observation carries an area identifier and an observation timestamp.",
				"responses": {
					"200": {
						"description": "Successful response with current observations",
						"content": {
							"application/json": {
								"schema": {
									"type": "array",
									"items": {
										"$ref": "#/components/schemas/AreaObservation"
									}
								}
							}
						}
					},
					"500": {
						"description": "Internal server error",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					}
				}
			}
		},
		"/observation-events": {
			"get": {
				"summary": "Stream observation events",
				"description": "Returns a stream of events when areas start or stop being observed. Allows consumers to close records without polling.",
				"responses": {
					"200": {
						"description": "Stream of observation events",
						"content": {
							"application/json": {
								"schema": {
									"type": "array",
									"items": {
										"$ref": "#/components/schemas/ObservationEvent"
									}
								}
							}
						}
					},
					"500": {
						"description": "Internal server error",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					}
				}
			}
		}
	},
	"components": {
		"schemas": {
			"AreaObservation": {
				"type": "object",
				"properties": {
					"area_id": {
						"type": "string",
						"description": "Unique identifier for the observed area/station. Danish station identifier, not display name.",
						"example": "STA-001"
					},
					"timestamp": {
						"type": "string",
						"format": "date-time",
						"description": "When the observation was recorded. UTC in ISO 8601 with offset.",
						"example": "2026-09-21T10:00:00+00:00"
					}
				},
				"required": ["area_id", "timestamp"]
			},
			"ObservationEvent": {
				"type": "object",
				"properties": {
					"area_id": {
						"type": "string",
						"description": "Area identifier that started or stopped being observed.",
						"example": "STA-001"
					},
					"timestamp": {
						"type": "string",
						"format": "date-time",
						"description": "When the area observation state changed. UTC in ISO 8601 with offset.",
						"example": "2026-09-21T10:00:00+00:00"
					},
					"event_type": {
						"type": "string",
						"enum": ["ENTER", "EXIT"],
						"description": "ENTER when area starts being observed, EXIT when area stops being observed."
					}
				},
				"required": ["area_id", "timestamp", "event_type"]
			},
			"Error": {
				"type": "object",
				"properties": {
					"code": {
						"type": "string",
						"description": "Machine-readable error code"
					},
					"message": {
						"type": "string",
						"description": "Human-readable error message intended for developers"
					}
				},
				"required": ["code", "message"]
			}
		}
	}
}
